rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connectivity test probe
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile: only the authenticated user can access their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollection for AlterEgo characters, quests, and progress
      match /alterego/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
